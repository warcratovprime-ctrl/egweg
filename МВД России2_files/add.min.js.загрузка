function sendLinkToEmail() {
    var d = $("#subscribe_b_send_email");
    var a = d.find("#send_link_email").val();
    if (!checkEmail(a)) {
        alert("Введите E-mail");
        $("#send_link_email").focus();
        return false
    }
    showAjaxLoader(".ajax-loader-send-link");
    d.find(".bsl-form").hide();
    var b = d.find("#send_link_item").val();
    var c = d.find("#send_link_comments").val();
    $.post("", {
        link: b,
        email: a,
        comments: c
    }, function(e) {
        if (e == "success") {
            d.find(".bsl-form").hide();
            d.find(".bsl-send-success").show();
            hideAjaxLoader(".ajax-loader-send-link")
        }
    }, "text")
}

function checkEmail(a) {
    if (!a) {
        return a
    }
    if (!a.match(/^[\w\.\-]+@[\w\.\-]+\.[a-zA-Z]{2,}$/i, "")) {
        return false
    }
    return true
}

function showAjaxLoader(a) {
    $(a).show()
}

function hideAjaxLoader(a) {
    $(a).hide()
};
